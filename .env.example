# Пример окружения для локального запуска.
# Скопировать в .env и при необходимости поправить: cp .env.example .env
# Файл .env в репозиторий не коммитится (см. .gitignore).

# ── Приложение ───────────────────────────────────────────────────────────────
APP_NAME=order-api
APP_ENV=local              # local | dev | prod
APP_VERSION=dev
LOG_LEVEL=debug            # debug | info | warn | error
LOG_FORMAT=text            # text локально читаемее, в проде json

# ── HTTP ─────────────────────────────────────────────────────────────────────
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# ── Жизненный цикл ───────────────────────────────────────────────────────────
# SHUTDOWN_TIMEOUT + DRAIN_DELAY должны укладываться в
# terminationGracePeriodSeconds пода (по умолчанию 30s), иначе прилетит SIGKILL.
SHUTDOWN_TIMEOUT=15s
DRAIN_DELAY=5s
READINESS_TIMEOUT=2s

# ── Инфраструктура (используется начиная с этапа 1) ───────────────────────────
POSTGRES_DSN=postgres://orderpulse:orderpulse@localhost:5433/orderpulse?sslmode=disable
KAFKA_BROKERS=localhost:9092
REDIS_ADDR=localhost:6379
CLICKHOUSE_ADDR=localhost:9001
CLICKHOUSE_DB=orderpulse
CLICKHOUSE_USER=orderpulse
CLICKHOUSE_PASSWORD=orderpulse
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=orderpulse
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
